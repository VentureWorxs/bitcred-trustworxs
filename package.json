{
  "name": "bitcred-trustworxs",
  "version": "0.1.0",
  "private": true,
  "description": "SD-JWT verifiable credential demo: issue, present, verify, and attack tests",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx src/keygen.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry"
  },
  "dependencies": {
    "@sd-jwt/crypto-browser": "^0.19.0",
    "@sd-jwt/sd-jwt-vc": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
